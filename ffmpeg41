#!/bin/sh
# This script is a wrapper over the binary ffmpeg41 which extract a frame from a video file to generate a thumbnail.
# It removes the default option -ss 00:00:03 (seek to 3 seconds) which extract the frame from the 3 seconds mark of the video.
# This option is slow than just getting the first frame.
# Placing the -ss option before the -i option is also faster (https://superuser.com/questions/1847624/ffmpeg-ss-option-and-keyframes) but I opted for just getting the first frame anyways.
# Example of how a thumbnail is generated by the system:
# /var/packages/CodecPack/target/pack/bin/ffmpeg41 -threads 2 -i /input/video.mp4 -threads 2 -y -vframes 1 -ss 00:00:03 -an -qscale:v 1 -f mjpeg /output/thumbnail.jpg
# To use this script move the original file /var/packages/CodecPack/target/pack/bin/ffmpeg41 to /var/packages/CodecPack/target/pack/bin/ffmpeg41.orig and place this script in the /var/packages/CodecPack/target/pack/bin/ folder with the same file permissions as the original file
input=$@
# remove -ss 00:00:00
output=$(echo "$input" | sed -E 's/-ss[[:space:]]+[0-9]{2}:[0-9]{2}:[0-9]{2}//')
# put quotes around input file path
output=$(echo "$output" | sed -E 's#(-i )(.*)( -threads)#\1"\2"\3#')
# put quotes around output file path
output=$(echo "$output" | sed -E 's#(mjpeg )(.*)#\1"\2"#')
# escape spaces in file paths
eval "array=($output)"
/var/packages/CodecPack/target/pack/bin/ffmpeg41.orig "${array[@]}"

